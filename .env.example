# Copy to .env (never commit .env).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
# Optional: OpenRouter and the platforms' own APIs (each provider exists only with its key)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
# Volcengine Ark (Doubao)
ARK_API_KEY=
# Optional: salt of the per-user id the platforms get (sha256 of salt + Telegram
# user id; OpenRouter `user`, OpenAI `safety_identifier`, …; not DeepSeek, Alibaba or
# Ark Chat). Any long random string, kept stable; empty: no user id is sent anywhere.
OPENROUTER_USER_SALT=
# This deployment (read by config/omni.example.toml; empty = its default).
# Telegram ids separated by commas: administrators (/ping shows your id), chats
# allowed once at the first start, users who may use pricier tiers.
OMNI_ADMINS=
OMNI_ALLOWED_CHATS=
OMNI_PRIORITY_USERS=
# What ends the model prefix (default $), e.g. % for a test bot next to the production one
OMNI_TRIGGER_MARKER=
