# Copy to .env (never commit .env).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
# Optional: the platforms' own APIs (each provider exists only with its key)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
# Volcengine Ark (Doubao)
ARK_API_KEY=
# Optional: salt for the hashed per-user id sent to OpenRouter (`user` field)
OPENROUTER_USER_SALT=
# This deployment (read by config/omni.example.toml; empty = its default).
# Telegram ids separated by commas: administrators (/ping shows your id), chats
# allowed once at the first start, users who may use pricier tiers.
OMNI_ADMINS=
OMNI_ALLOWED_CHATS=
OMNI_PRIORITY_USERS=
# What ends the model prefix (default $), e.g. % for a test bot next to the production one
OMNI_TRIGGER_MARKER=
